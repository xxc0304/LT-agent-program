# Local runtime output
*.log
tmp/

# Dependencies
**/node_modules/

# Local-only source-document extraction and rendered reference media
# These may contain project-provided plans, reports, patent topics, or screenshots.
extracted/
rendered_ppt/

# Local environment and credentials
.env
.env.*
*.pem
*.key
credentials.json

# Local SCB dataset and evaluation outputs (do not commit raw data)
learning-behavior/data/scb/raw/
learning-behavior/data/scb/images/
learning-behavior/data/scb/results/
learning-behavior/data/scb/blind-review/
learning-behavior/outputs/2026-09-26-annotation-review/

# Local-only household preference memory; never commit personal routines/preferences
**/family-memory*.json
**/family-memory*.json.lock
**/family-memory*.json.*.tmp
**/family-memory*.json.*.backup
**/family-memory*.sqlite*
**/memory-data/

# Runtime conversation/memory snapshots are local data, not agent source or fixtures
/device-manager/agent-workspace/memory/.dreams/
/device-manager/agent-workspace/memory/dreaming/

# Local generated deployment archives and runtime caches
/output/
**/node-compile-cache/

# OpenClaw-generated workspace snapshots and user-specific bootstrap notes
**/openclaw-workspace-state.json
/device-manager/agent-workspace/USER.md
/openclaw-agents/*/USER.md

# Local first-pass annotation draft; keep unreviewed labels out of Git
/learning-behavior/ANNOTATION_FIRST_PASS_DRAFT.jsonl
