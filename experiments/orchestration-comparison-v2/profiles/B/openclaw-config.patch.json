{
  "gateway": {
    "port": 19911,
    "bind": "loopback",
    "auth": {
      "mode": "none"
    },
    "mode": "local"
  },
  "models": {
    "providers": {
      "dscompat": {
        "models": [
          {
            "id": "deepseek-v4-flash",
            "input": [
              "text"
            ],
            "reasoning": true,
            "name": "DeepSeek V4 Flash (OpenAI-compatible pilot)",
            "maxTokens": 64000,
            "contextWindow": 1000000
          }
        ],
        "apiKey": {
          "source": "env",
          "provider": "default",
          "id": "LT_EXPERIMENT_API_KEY"
        },
        "api": "openai-completions",
        "baseUrl": "https://api.deepseek.com/v1"
      }
    }
  },
  "agents": {
    "list": [
      {
        "tools": {
          "allow": [
            "orchestrate_household_agents"
          ]
        },
        "default": true,
        "workspace": "__EXP_ROOT__/profiles/B/workspaces/dev",
        "id": "dev"
      },
      {
        "tools": {
          "allow": []
        },
        "id": "device-manager",
        "workspace": "__REPO_ROOT__/experiments/orchestration-comparison-v1/fixtures/workspaces/device_steward"
      },
      {
        "tools": {
          "allow": []
        },
        "id": "security-review-fixture",
        "workspace": "__REPO_ROOT__/experiments/orchestration-comparison-v1/fixtures/workspaces/safety_review"
      },
      {
        "tools": {
          "allow": []
        },
        "id": "energy-saving",
        "workspace": "__REPO_ROOT__/experiments/orchestration-comparison-v1/fixtures/workspaces/energy_manager"
      },
      {
        "tools": {
          "allow": []
        },
        "id": "learning-companion",
        "workspace": "__REPO_ROOT__/experiments/orchestration-comparison-v1/fixtures/workspaces/learning_companion"
      }
    ],
    "defaults": {
      "model": {
        "primary": "dscompat/deepseek-v4-flash"
      }
    }
  },
  "secrets": {
    "providers": {
      "default": {
        "allowlist": [
          "LT_EXPERIMENT_API_KEY"
        ],
        "source": "env"
      }
    }
  },
  "plugins": {
    "entries": {
      "platform-orchestrator": {
        "enabled": true,
        "config": {
          "additionalAgents": [
            {
              "description": "实验用只读安全评估角色，不是已登记的生产 Agent",
              "capabilities": [
                {
                  "description": "审查人员状态证据的新鲜度和可信度",
                  "effect": "read_only",
                  "name": "review_presence_evidence"
                },
                {
                  "description": "识别相互矛盾的家庭设备指令",
                  "effect": "read_only",
                  "name": "detect_instruction_conflict"
                },
                {
                  "description": "审查门锁等敏感动作的身份验证与授权要求",
                  "effect": "read_only",
                  "name": "review_sensitive_action_authorization"
                },
                {
                  "description": "审查事件来源、可信度与时效性",
                  "effect": "read_only",
                  "name": "assess_event_uncertainty"
                }
              ],
              "name": "安全评估 fixture",
              "agent_id": "security-review-fixture"
            }
          ],
          "frontdoorAgentId": "dev"
        }
      }
    }
  },
  "tools": {
    "profile": "minimal",
    "agentToAgent": {
      "allow": [
        "dev",
        "device-manager",
        "security-review-fixture",
        "energy-saving",
        "learning-companion"
      ],
      "enabled": true
    },
    "alsoAllow": [
      "orchestrate_household_agents"
    ],
    "sessions": {
      "visibility": "all"
    }
  }
}
