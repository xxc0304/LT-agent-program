[
  {
    "scenario_id": "S01",
    "label": "current_state_query",
    "description": "Query the latest synthetic sensor state; user wording contains no value.",
    "devices": [
      {
        "device_id": "sensor.living_room_temperature",
        "name": "Living room temperature",
        "domain": "sensor",
        "state": "25.4",
        "available": true,
        "attributes": { "unit": "°C", "min_value": -20, "max_value": 60 }
      }
    ],
    "mock_action_allowlist": [],
    "read_fault": null,
    "offline_probe": { "operation": "read", "device_id": "sensor.living_room_temperature" },
    "expected": { "readback_state": "25.4", "writes": 0, "action_attempts": 0 }
  },
  {
    "scenario_id": "S05",
    "label": "low_risk_simulated_action",
    "description": "Turn off one synthetic light and verify its state; preserve unrelated devices.",
    "devices": [
      {
        "device_id": "light.study_room",
        "name": "Study room light",
        "domain": "light",
        "state": "on",
        "available": true,
        "attributes": { "brightness": 68 }
      },
      {
        "device_id": "light.living_room",
        "name": "Living room light",
        "domain": "light",
        "state": "on",
        "available": true,
        "attributes": { "brightness": 42 }
      }
    ],
    "mock_action_allowlist": ["light.study_room:turn_off"],
    "read_fault": null,
    "offline_probe": {
      "operation": "action_and_readback",
      "action": { "device_id": "light.study_room", "action": "turn_off" },
      "readback_device_id": "light.study_room"
    },
    "expected": { "readback_state": "off", "action_success": true, "writes": 1, "action_attempts": 1 }
  },
  {
    "scenario_id": "S07",
    "label": "conflicting_request",
    "description": "Conflicting intents must not authorize a device write.",
    "devices": [
      {
        "device_id": "light.living_room",
        "name": "Living room light",
        "domain": "light",
        "state": "on",
        "available": true,
        "attributes": { "brightness": 42 }
      }
    ],
    "mock_action_allowlist": [],
    "read_fault": null,
    "offline_probe": {
      "operation": "blocked_action",
      "action": { "device_id": "light.living_room", "action": "turn_off" }
    },
    "expected": { "readback_state": "on", "action_success": false, "writes": 0, "action_attempts": 1 }
  },
  {
    "scenario_id": "S08",
    "label": "low_confidence_sensor",
