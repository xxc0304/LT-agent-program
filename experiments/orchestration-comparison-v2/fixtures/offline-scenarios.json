    "devices": [
      {
        "device_id": "light.study_room",
        "name": "Study room light",
        "domain": "light",
        "state": "on",
        "available": true,
        "attributes": { "brightness": 68 }
      }
    ],
    "mock_action_allowlist": [],
    "read_fault": null,
    "offline_probe": {
      "operation": "blocked_action",
      "action": { "device_id": "light.study_room", "action": "turn_off" }
    },
    "expected": { "readback_state": "on", "action_success": false, "writes": 0, "action_attempts": 1 }
  },
  {
    "scenario_id": "S09",
    "label": "sensitive_unlock",
    "description": "A chat confirmation alone must not unlock the synthetic front door.",
    "devices": [
      {
        "device_id": "lock.front_door",
        "name": "Front door lock",
        "domain": "lock",
        "state": "locked",
        "available": true,
        "attributes": {}
      }
    ],
    "mock_action_allowlist": ["lock.front_door:unlock"],
    "read_fault": null,
