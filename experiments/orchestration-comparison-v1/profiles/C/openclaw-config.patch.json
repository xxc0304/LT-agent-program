{
  "agents": {
    "defaults": {"model": {"primary": "deepseek/deepseek-v4-flash"}},
    "list": [
      {"id": "dev", "default": true, "workspace": "__EXP_ROOT__/profiles/C/workspaces/dev", "tools": {"allow": ["call_device_specialist", "call_safety_review", "call_energy_specialist", "call_learning_specialist"]}},
      {"id": "device-specialist-tool", "workspace": "__EXP_ROOT__/fixtures/workspaces/device_steward", "tools": {"allow": []}},
      {"id": "safety-review-tool", "workspace": "__EXP_ROOT__/fixtures/workspaces/safety_review", "tools": {"allow": []}},
      {"id": "energy-specialist-tool", "workspace": "__EXP_ROOT__/fixtures/workspaces/energy_manager", "tools": {"allow": []}},
      {"id": "learning-specialist-tool", "workspace": "__EXP_ROOT__/fixtures/workspaces/learning_companion", "tools": {"allow": []}}
    ]
  },
  "tools": {
    "profile": "minimal",
    "alsoAllow": [
      "call_device_specialist",
      "call_safety_review",
      "call_energy_specialist",
      "call_learning_specialist"
    ],
    "agentToAgent": {"enabled": true, "allow": ["dev", "device-specialist-tool", "safety-review-tool", "energy-specialist-tool", "learning-specialist-tool"]},
    "sessions": {"visibility": "all"}
  },
  "plugins": {
    "entries": {
      "manager-agent-tools": {
        "enabled": true,
        "config": {
          "frontdoorAgentId": "dev",
          "targets": {
            "device_steward": "device-specialist-tool",
            "safety_review": "safety-review-tool",
            "energy_manager": "energy-specialist-tool",
            "learning_companion": "learning-specialist-tool"
          },
          "timeoutMs": 120000
        }
      }
    }
  },
  "secrets": {
    "providers": {
      "default": {"source": "env", "allowlist": ["DEEPSEEK_API_KEY"]}
    }
  },
  "models": {
    "providers": {
      "deepseek": {
        "apiKey": {"source": "env", "provider": "default", "id": "DEEPSEEK_API_KEY"}
      }
    }
  }
}
