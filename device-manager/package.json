{
  "name": "lt-device-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "家庭微脑设备管家 Agent 的 Home Assistant 适配与基础设备工具",
  "scripts": {
    "demo": "node src/demo.js",
    "demo:plug": "node src/plug-demo.js",
    "demo:orchestration": "node src/orchestrator-demo.js",
    "acceptance": "node src/acceptance.js",
    "ha:check": "node src/check-ha.js",
    "test": "node --test",
    "plugin:validate": "openclaw plugins validate --root . --entry ./src/openclaw-plugin.js",
    "contracts:validate": "node ..\\common-contracts\\validate-examples.mjs",
    "verify": "npm test && npm run acceptance && npm run plugin:validate && npm run contracts:validate"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "openclaw": {
    "extensions": [
      "./src/openclaw-plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": ">=2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  }
}
