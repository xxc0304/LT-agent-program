{
  "name": "lt-device-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "家庭微脑设备管家 Agent 的 Home Assistant 适配、基础设备工具和多 Agent 事件调度桥接",
  "scripts": {
    "demo": "node src/demo.js",
    "demo:plug": "node src/plug-demo.js",
    "demo:orchestration": "node src/orchestrator-demo.js",
    "demo:interface-faults": "node src/interface-fault-demo.js",
    "demo:agent-event": "node src/agent-event-demo.js",
    "demo:inventory": "node src/device-inventory-demo.js",
    "demo:device-monitor": "node src/device-monitor-demo.js",
    "demo:adaptive-energy": "node src/adaptive-energy-scene-demo.js",
    "demo:mock-memory-learning": "node src/mock-memory-learning-demo.js",
    "demo:preference-conflict": "node src/mock-preference-conflict-demo.js",
    "demo:routine-reminders": "node src/routine-reminder-demo.js",
    "demo:maintenance-reminders": "node src/maintenance-reminder-demo.js",
    "maintenance:lock-status": "node src/inspect-maintenance-store-lock.js",
    "demo:independent-agent-chain": "node src/independent-learning-energy-demo.js",
    "demo:mock-replan": "node src/mock-replan-demo.js",
    "acceptance": "node src/acceptance.js",
    "ha:check": "node src/check-ha.js",
    "ha:monitor-smoke": "node src/ha-monitor-smoke.js",
    "test": "node --test",
    "plugin:validate": "openclaw plugins validate --root . --entry ./src/openclaw-plugin.js",
    "contracts:test": "node --test ../common-contracts/test/task-compat.test.mjs",
    "contracts:validate": "node ../common-contracts/validate-examples.mjs",
    "verify": "npm test && npm run acceptance && npm run plugin:validate && npm run contracts:test && npm run contracts:validate"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "openclaw": {
    "extensions": [
      "./src/openclaw-plugin.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17",
      "minGatewayVersion": ">=2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  }
}
