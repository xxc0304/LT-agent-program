{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lt-agent-program.local/contracts/policy-decision.schema.json",
  "title": "家庭微脑策略决策",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "task_id", "trace_id", "decision", "decided_at", "reason_code", "reason_message", "confirmation_required"],
  "properties": {
    "schema_version": { "type": "string", "const": "0.1" },
    "decision_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["ALLOW", "DENY", "CHALLENGE"] },
    "decided_at": { "type": "string", "format": "date-time" },
    "reason_code": { "type": "string", "minLength": 1 },
    "reason_message": { "type": "string", "minLength": 1 },
    "confirmation_required": { "type": "boolean" },
    "required_confirmation": { "type": "string", "minLength": 1 },
    "policy_agent": { "type": "string", "minLength": 1 }
  }
}
